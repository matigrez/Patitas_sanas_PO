<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="750.0" prefWidth="710.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.POO.patitassanas.controller.FormController">

   <top>
      <VBox prefHeight="70.0" prefWidth="640.0" spacing="4.0" style="-fx-background-color: #1B365D;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <Label fx:id="lblTituloFormulario" prefHeight="27.0" prefWidth="215.0" text="Registro de Ficha clínica" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label prefHeight="17.0" prefWidth="333.0" text="Complete los datos del tutor y la ficha médica de la mascota" textFill="#e2e8f0" />
         </children>
      </VBox>
   </top>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="53.0" prefWidth="640.0" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <Label fx:id="lblError" prefHeight="17.0" prefWidth="449.0" textFill="RED" wrapText="true">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#registrar" prefWidth="100.0" text="Guardar Ficha" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" prefWidth="100.0" text="Cancelar" />
         </children>
      </HBox>
   </bottom>
   <center>
      <VBox prefHeight="535.0" prefWidth="669.0" spacing="14.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
         </padding>
         <children>
            <Label prefHeight="17.0" prefWidth="220.0" text="1.Datos del Tutor Responsable" textFill="#1b365d">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <GridPane hgap="15.0" prefHeight="104.0" prefWidth="660.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints maxHeight="37.0" minHeight="10.0" prefHeight="24.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="36.0" minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <VBox prefHeight="48.0" prefWidth="463.0" spacing="6.0">
                     <children>
                        <Label prefHeight="17.0" prefWidth="75.0" text="RUT Tutor" />
                        <HBox prefHeight="25.0" prefWidth="461.0" spacing="6.0">
                           <children>
                              <TextField fx:id="txtRutTutor" promptText="12345678-9" />
                              <Button fx:id="btnBuscarTutor" mnemonicParsing="false" text="Buscar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="6.0" GridPane.columnIndex="1">
                     <children>
                        <Label prefHeight="17.0" prefWidth="140.0" text="Nombre Completo:" />
                        <TextField fx:id="txtNombreTutor" promptText="Nombre y apellido del tutor" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="6.0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1">
                     <children>
                        <Label text="Correo Electrónico">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="txtCorreo" layoutX="10.0" layoutY="33.0" promptText="Correo@ejemplo.cl" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label text="Teléfono">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="txtTelefono" promptText="912345678" />
                     </children>
                  </VBox>
               </children>
            </GridPane>
            <Separator prefWidth="200.0" />
            <Label text="2. Datos Clínicos de la mascota" textFill="#1b365d">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <GridPane hgap="15.0" prefHeight="234.0" prefWidth="660.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.3" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.3" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.3" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0">
                     <children>
                        <Label text="Código ficha:" />
                        <TextField fx:id="txtCodeficha" promptText="VET-1045A" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0" GridPane.columnIndex="1">
                     <children>
                        <Label text="Nombre Mascota:" />
                        <TextField fx:id="txtNombremascota" promptText="Ej: Toby" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0" GridPane.columnIndex="2">
                     <children>
                        <Label text="Apto para Vacunar?" />
                        <CheckBox fx:id="chkVacunable" mnemonicParsing="false" onAction="#actualizarTextField" text="Si/No" />
                        <TextField fx:id="txtNombreVacuna" disable="true" promptText="Ingrese el nombre de la vacuna" />
                        <Label text="Especie:" />
                        <ComboBox fx:id="cmbEspecie" maxWidth="1.7976931348623157E308" onAction="#actualizarBox" prefWidth="150.0" promptText="Seleccione..." />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0" GridPane.rowIndex="1">
                     <children>
                        <Label text="Edad (meses):" />
                        <TextField fx:id="txtEdadmeses" promptText="0 a 240" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="210.0" spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label text="Peso (kg):" />
                        <TextField fx:id="txtPeso" promptText="Ej: 12.5" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                     <children>
                        <Label text="Estado Clinico:" />
                        <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" prefWidth="150.0" promptText="Ingresado" />
                     </children>
                  </VBox>
               </children>
            </GridPane>
            <Separator prefWidth="200.0" />
            <Label prefHeight="20.0" prefWidth="287.0" text="3. Características Específicas por Especie" textFill="#1b365d">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <HBox prefHeight="136.0" prefWidth="590.0" spacing="15.0">
               <children>
                  <VBox fx:id="boxPerro" prefHeight="153.0" prefWidth="114.0" spacing="8.0" style="-fx-background-color: #CBD5E1; -fx-border-radius: 5; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Datos del Perro" textFill="#1b365d">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <Label text="Tamaño:" />
                        <ComboBox fx:id="cmbTamanoPerro" maxWidth="1.7976931348623157E308" prefWidth="150.0" promptText="Seleccione..." />
                        <Label text="Nivel de adiestramiento:" />
                        <ComboBox fx:id="cmbNivelAd" maxWidth="1.7976931348623157E308" prefWidth="150.0" promptText="Seleccione..." />
                     </children>
                  </VBox>
                  <VBox fx:id="boxGato" prefHeight="200.0" prefWidth="100.0" spacing="8.0" style="-fx-background-color: #CBD5E1; -fx-border-radius: 5; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Datos del Gato" textFill="#1b365d">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <Label text="Estilo de vida:" />
                        <ComboBox fx:id="cmbEstiloVida" maxWidth="1.7976931348623157E308" prefWidth="150.0" promptText="Seleccione..." />
                        <Label text="Tipo de Pelaje:" />
                        <ComboBox fx:id="cmbTipoPelaje" maxWidth="1.7976931348623157E308" prefWidth="150.0" promptText="Seleccione..." />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
