<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="620.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox prefHeight="70.0" prefWidth="640.0" spacing="4.0" style="-fx-background-color: #1B365D;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <Label fx:id="lblTituloFormulario" prefHeight="27.0" prefWidth="215.0" text="Registro de Ficha clínica" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label prefHeight="17.0" prefWidth="333.0" text="Complete los datos del tutor y la ficha médica de la mascota" textFill="#e2e8f0" />
         </children>
      </VBox>
   </top>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <Button fx:id="btnGuardar" mnemonicParsing="false" prefWidth="100.0" text="Guardar Ficha" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" prefWidth="100.0" text="Cancelar" />
         </children>
      </HBox>
   </bottom>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="14.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
         </padding>
         <children>
            <Label prefHeight="17.0" prefWidth="220.0" text="1.Datos del Tutor Responsable" textFill="#1b365d">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <GridPane hgap="15.0" prefHeight="100.0" prefWidth="590.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints maxHeight="37.0" minHeight="10.0" prefHeight="24.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="36.0" minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <VBox prefHeight="48.0" prefWidth="463.0" spacing="6.0">
                     <children>
                        <Label prefHeight="17.0" prefWidth="75.0" text="RUT Tutor" />
                        <HBox prefHeight="25.0" prefWidth="461.0" spacing="6.0">
                           <children>
                              <TextField fx:id="txtRutTutor" promptText="12345678-9" />
                              <Button fx:id="btnBuscarTutor" mnemonicParsing="false" text="Buscar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="6.0" GridPane.columnIndex="1">
                     <children>
                        <Label prefHeight="17.0" prefWidth="140.0" text="Nombre Completo:" />
                        <TextField fx:id="txtNombreTutor" promptText="Nombre y apellido del tutor" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="6.0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1">
                     <children>
                        <Label text="Correo Electrónico" />
                        <TextField fx:id="txtcorreo" layoutX="10.0" layoutY="33.0" promptText="Correo@ejemplo.cl" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label text="Teléfono" />
                        <TextField fx:id="txttelefono" promptText="912345678" />
                     </children>
                  </VBox>
               </children>
            </GridPane>
         </children>
      </VBox>
   </center>
</BorderPane>
