<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.POO.patitassanas.controller.MainController">
    <top>
        <VBox prefHeight="35.0" prefWidth="900.0" spacing="4.0" style="-fx-background-color: #1B365D;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Label text="Clínica Veterinaria Patitas Sanas" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Gestión de Pacientes, Fichas Clínicas y Control de Atención" textFill="#E2E8F0">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <TextField fx:id="txtBuscar" prefWidth="280.0" promptText="Buscar por código VET o tutor..." />
                        <ComboBox fx:id="cmbFiltroTipo" prefWidth="170.0" promptText="Todas las especies" />
                        <Button fx:id="btnNuevo" mnemonicParsing="false" onAction="#onNuevo" text="Nuevo Registro" />
                        <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#onEditar" text="Editar" />
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminar" text="Eliminar" />
                    </children>
                </HBox>
                <TableView fx:id="tblMascotas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="110.0" text="Código Ficha" />
                        <TableColumn fx:id="colEspecie" prefWidth="100.0" text="Especie" />
                        <TableColumn fx:id="colMascota" prefWidth="150.0" text="Mascota" />
                        <TableColumn fx:id="colTutor" prefWidth="180.0" text="Tutor" />
                        <TableColumn fx:id="colEstado" prefWidth="130.0" text="Estado" />
                        <TableColumn fx:id="colCosto" prefWidth="140.0" text="Costo Estimado ($)" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="25.0" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>
                <Label fx:id="lblTotalMascotas" text="Total Mascotas: 0">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <Label fx:id="lblTotalCosto" text="Total Estimado: $0">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </bottom>
</BorderPane>
